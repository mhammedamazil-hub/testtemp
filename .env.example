# ---------------------------------------------------------------------------
# Idol Image-to-3D Studio — copy to .env and edit. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# development | production
IDOL_ENVIRONMENT=production

# Where uploads, verified artefacts and the SQLite history live.
IDOL_DATA_DIR=/data
# Built SPA served by the API (the Docker image sets this for you).
IDOL_FRONTEND_DIST=/app/frontend_dist

# --- GPU worker -------------------------------------------------------------
# ComfyUI with ComfyUI-Idol installed. Use http://comfyui:8188 inside compose.
IDOL_COMFYUI_URL=http://comfyui:8188
# Only needed when ComfyUI itself is behind an authenticating proxy.
# IDOL_COMFYUI_API_KEY=
IDOL_JOB_TIMEOUT_SECONDS=1800
IDOL_MAX_CONCURRENT_JOBS=1
IDOL_MAX_QUEUE_SIZE=64

# Must stay false in production: the simulator does not run Idol inference.
IDOL_ALLOW_SIMULATED_WORKER=false

# --- limits -----------------------------------------------------------------
IDOL_MAX_UPLOAD_MB=20
IDOL_RATE_LIMIT_PER_MINUTE=60
IDOL_UPLOADS_PER_MINUTE=12

# --- model file names as ComfyUI lists them --------------------------------
IDOL_MODEL_UNET=idol_fp32.safetensors
IDOL_MODEL_VAE_DECODER=idol_vae_decoder_fp32.safetensors
IDOL_MODEL_CLIP_VISION=dino_v3_vit_h.safetensors
IDOL_MODEL_FLUX_VAE=flux2-vae.safetensors
IDOL_MODEL_BG_REMOVAL=birefnet.safetensors

# --- worker container (docker compose) -------------------------------------
# fp32 (quality) or fp16 (half the disk, same speed at default precision)
IDOL_WEIGHTS_VARIANT=fp32
# Set to 0 to skip the model download step on boot.
DOWNLOAD_MODELS=1
# Optional Hugging Face token for gated downloads (never commit it).
# HF_TOKEN=
COMFYUI_REF=v0.43.0
COMFYUI_IDOL_REF=59ed4b43f0d04a2c8bac689f99e51901dd7c2329

# --- studio container -------------------------------------------------------
STUDIO_PORT=8000
