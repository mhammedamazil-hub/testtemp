# Obscura binaries are large (~70 MB each) and machine-specific.
# Install them with scripts/install_obscura.sh; do not commit them.
vendor/obscura/*
!vendor/obscura/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Transient native-LLM session state (the trace is committed instead)
evals/.native_session.json

# Composio audit log (records what ran; may include account identifiers)
logs/
