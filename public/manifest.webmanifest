{
  "name": "SourceForge — grounded research workspace",
  "short_name": "SourceForge",
  "description": "Local-first NotebookLM-style research workspace: import sources, ask cited questions, generate study material and export real documents. No account required.",
  "id": "/sourceforge",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#080d17",
  "theme_color": "#0b1220",
  "categories": ["productivity", "education", "utilities"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "New notebook",
      "short_name": "New",
      "description": "Start an empty research notebook",
      "url": "./#new",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Search workspace",
      "short_name": "Search",
      "description": "Search every notebook and source",
      "url": "./#search",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
