# Source manifest: local name | github owner/repo | git ref (- = default branch) | purpose
# Every repo is reachable via github.com (the only git host allowed by the
# sandbox egress policy). deepin-community trees are upstream "make dist"
# imports and therefore ship pre-generated configure/Makefile.in.

# --- build toolchain ---
pkgconf|pkgconf/pkgconf|-|pkg-config implementation
m4|deepin-community/m4|-|GNU m4 (autotools bootstrap)
autoconf|deepin-community/autoconf|-|GNU autoconf
automake|deepin-community/automake-1.17|-|GNU automake + aclocal
libtool|deepin-community/libtool|-|GNU libtool + libtoolize
gperf|deepin-community/gperf|-|perfect hash generator (fontconfig)

# --- base libraries ---
zlib|deepin-community/zlib|-|compression runtime
libpng1.6|deepin-community/libpng1.6|-|PNG library
expat|deepin-community/expat|-|XML parser (fontconfig)
freetype|deepin-community/freetype|-|font rasterizer
harfbuzz|deepin-community/harfbuzz|-|text shaping (st terminal)
libmd|deepin-community/libmd|-|message digest (SHA1 for Xvfb)
openssl|openssl/openssl|openssl-3.0.15|TLS library (x11vnc, bpy)
mbedtls|Mbed-TLS/mbedtls|archive/mbedtls-2.28|TLS library (dillo HTTPS)
libjpeg-turbo|libjpeg-turbo/libjpeg-turbo|-|JPEG codec (libvncserver)

# --- X11 protocol core ---
xorgproto|deepin-community/xorgproto|-|X11 protocol headers
xtrans|deepin-community/xtrans|-|X transport data files
libxau|deepin-community/libxau|-|X authorization
libxdmcp|deepin-community/libxdmcp|-|X display manager control
xcb-proto|deepin-community/xcb-proto|-|XCB protocol descriptions
libxcb|deepin-community/libxcb|-|X C binding
libx11|deepin-community/libx11|-|core X11 client library

# --- X11 extension libraries ---
libxext|deepin-community/libxext|-|X extension framework
libxrender|deepin-community/libxrender|-|X Render extension (patched, see patches/)
libxfixes|deepin-community/libxfixes|-|Xfixes extension
libxi|deepin-community/libxi|-|XInput extension
libxrandr|deepin-community/libxrandr|-|RandR extension
libxinerama|deepin-community/libxinerama|-|Xinerama extension
libxcursor|deepin-community/libxcursor|-|cursor management
libxcomposite|deepin-community/libxcomposite|-|compositing extension
libxdamage|deepin-community/libxdamage|-|damage extension
libxtst|deepin-community/libxtst|-|XTest + Record (input injection)
libxss|deepin-community/libxss|-|screensaver extension
libxpm|deepin-community/libxpm|-|XPM image support
libice|deepin-community/libice|-|ICE
libsm|deepin-community/libsm|-|SM
libxt|deepin-community/libxt|-|X toolkit
libxmu|deepin-community/libxmu|-|Xmu
libxv|deepin-community/libxv|-|Xvideo
libxres|deepin-community/libxres|-|X resource extension
libxxf86vm|deepin-community/libxxf86vm|-|XF86 VidMode (Blender dependency)
libxkbcommon|deepin-community/libxkbcommon|-|keyboard library (Blender dependency)
libglvnd|NVIDIA/libglvnd|-|GL dispatch stubs (headless, no GPU driver)

# --- X server font/keyboard stack ---
pixman|deepin-community/pixman|-|pixel manipulation
libfontenc|deepin-community/libfontenc|-|X font encoding
libxfont|deepin-community/libxfont|-|libXfont2 server-side fonts
libxkbfile|deepin-community/libxkbfile|-|xkb file handling
fontconfig|deepin-community/fontconfig|-|font configuration
libxft|loongson-community/libXft|-|freetype/fontconfig X fonts (hand-written meson)
xkeyboard-config|deepin-community/xkeyboard-config|-|keyboard layouts
x11-xkb-utils|deepin-community/x11-xkb-utils|-|xkbcomp and friends
xauth|deepin-community/xauth|-|X authority utility
xbitmaps|deepin-community/xbitmaps|-|common X bitmaps
ncurses|deepin-community/ncurses|-|terminal library + tic

# --- display server and utilities ---
xorg-server|deepin-community/xorg-server|-|Xvfb display server 21.1.x
x11-utils|deepin-community/x11-utils|-|xdpyinfo/xprop/xwininfo/xev
x11-xserver-utils|deepin-community/x11-xserver-utils|-|xrandr/xrdb/xset/xmodmap/xhost
xautomation|deepin-community/xautomation|-|xte input injection CLI

# --- desktop environment ---
dwm|suckless-koala/dwm|-|window manager
st|suckless-koala/st|-|terminal emulator
dmenu|suckless-koala/dmenu|-|launcher
vim|vim/vim|-|terminal code editor

# --- applications ---
fltk13|fltk/fltk|branch-1.3|-|FLTK 1.3 GUI toolkit (dillo)
dillo|dillo-browser/dillo|-|lightweight web browser

# --- remote access ---
libvncserver|LibVNC/libvncserver|-|VNC server library
x11vnc|LibVNC/x11vnc|-|VNC server attached to the live X display
novnc|novnc/noVNC|-|browser VNC client (checked out into local/share/novnc)
bison-rel|tar-mirror/gnu-bison|-|GNU bison 3.0.4 release-tarball mirror, pregenerated scanners (no flex/gnulib bootstrap)

# --- Openbox WM dependency chain (glib/pango/xml2 stack) ---
libffi|libffi/libffi|v3.4.6|foreign function interface (glib dependency)
pcre2|PCRE2Project/pcre2|pcre2-10.44|perl-compatible regex 2 (glib dependency)
glib|GNOME/glib|2.80.4|core application library (openbox/pango dependency)
fribidi|fribidi/fribidi|v1.0.15|unicode bidi algorithm (pango dependency)
pango|GNOME/pango|1.54.0|text layout with Xft backend (openbox dependency)
libxml2|GNOME/libxml2|v2.13.9|XML parser (openbox rc.xml)
gettext|deepin-community/gettext|-|real autopoint + m4 macros (openbox bootstrap)
openbox|danakj/openbox|-|lightweight window manager (explicit requirement)
